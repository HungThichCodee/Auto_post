# Google AI Studio free API key
GEMINI_API_KEY=your_gemini_api_key_here

# Facebook session cookies as JSON string
FB_COOKIES=[{"name": "c_user", "value": "12345", "domain": ".facebook.com", "path": "/"}]

# TikTok session cookies as JSON string
TIKTOK_COOKIES=[{"name": "sessionid", "value": "xyz", "domain": ".tiktok.com", "path": "/"}]

# YouTube session cookies as JSON string
YT_COOKIES=[{"name": "SSID", "value": "abc", "domain": ".youtube.com", "path": "/"}]

# Comma-separated proxy URLs, optional
PROXY_LIST=http://proxy1.com:8080,http://proxy2.com:8080

# Facebook fanpage URL to post to
FB_PAGE_URL=https://www.facebook.com/your.page.name

# TikTok upload page URL (optional, default uses creator center)
TIKTOK_UPLOAD_URL=https://www.tiktok.com/creator-center/upload?mode=photo

# YouTube channel URL for Community tab posting
YT_CHANNEL_URL=https://www.youtube.com/channel/YOUR_CHANNEL_ID
